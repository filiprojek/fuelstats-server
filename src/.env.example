# General
APP_PORT = 6060
APP_HOSTNAME = 'localhost'
APP_HOST = 'http://localhost:8080' # frontend url
# Public URL of this API (OIDC callbacks). Defaults to APP_HOST when the frontend proxies /api/v1
# API_PUBLIC_URL = 'http://localhost:6060'

# Timezone
TZ = 'Europe/Prague'

CORS_WHITELIST = http://10.69.0.23:8080;http://192.168.0.1:8080
JWT_SECRET = ''
# How long "Remember me" keeps users signed in, in days (renewed while the app is used)
AUTH_REMEMBER_DAYS = 30
# Maximum request body size; service photos are uploaded inside the JSON body
BODY_LIMIT = '25mb'

# MongoDB
DB_URI = 'mongodb://username:password@localhost:27017/fuelstats?authSource=admin'

# SMTP
SMTP_HOST = ''
SMTP_USER = ''
SMTP_PASS = ''
SMTP_FROM = ''

# Single sign-on (OpenID Connect) - comma separated provider ids, see README
OIDC_PROVIDERS = ''
# OIDC_AUTHELIA_ISSUER = 'https://auth.example.com'
# OIDC_AUTHELIA_CLIENT_ID = 'fuelstats'
# OIDC_AUTHELIA_CLIENT_SECRET = ''
# OIDC_AUTHELIA_NAME = 'Authelia'
# OIDC_AUTHELIA_SCOPES = 'openid profile email'
# OIDC_AUTHELIA_ALLOW_SIGNUP = true
